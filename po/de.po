msgid "No monitors configured"
msgstr "Keine Monitore konfiguriert"

msgid "Settings"
msgstr "Einstellungen"

msgid "Shell"
msgstr "Shell"

msgid "JavaScript"
msgstr "JavaScript"

msgid "Add Monitor"
msgstr "Monitor hinzufügen"

msgid "Edit Monitor"
msgstr "Monitor bearbeiten"

msgid "Cancel"
msgstr "Abbrechen"

msgid "Save"
msgstr "Speichern"

msgid "Name"
msgstr "Name"

msgid "e.g. CPU Usage"
msgstr "z. B. CPU-Auslastung"

msgid "Optional: what this monitor measures"
msgstr "Optional: Was dieser Monitor misst"

msgid "Setup instructions…"
msgstr "Einrichtungsanleitung…"

msgid "Command / Script"
msgstr "Befehl / Skript"

msgid "Type"
msgstr "Typ"

msgid "Arguments"
msgstr "Argumente"

msgid "+ Add"
msgstr "+ Hinzufügen"

msgid "JS: injected as const NAME = value  ·  Shell: injected as export NAME=value"
msgstr "JS: als const NAME = value eingefügt  ·  Shell: als export NAME=value eingefügt"

msgid "value"
msgstr "Wert"

msgid "Add Argument"
msgstr "Argument hinzufügen"

msgid "Add"
msgstr "Hinzufügen"

msgid "Identifier, e.g. EXCLUDE (no spaces)"
msgstr "Bezeichner, z. B. EXCLUDE (keine Leerzeichen)"

msgid "Display label, e.g. Exclude processes"
msgstr "Anzeigebezeichnung, z. B. Prozesse ausschließen"

msgid "Label"
msgstr "Bezeichnung"

msgid "Actions"
msgstr "Aktionen"

msgid "Commands run on demand from the monitor icon in the menu."
msgstr "Befehle, die auf Anfrage über das Monitor-Symbol im Menü ausgeführt werden."

msgid "Action label"
msgstr "Aktionsbezeichnung"

msgid "Command or script"
msgstr "Befehl oder Skript"

msgid "JS condition on value (e.g. value === 'disabled')"
msgstr "JS-Bedingung für den Wert (z. B. value === 'disabled')"

msgid "Interval (s)"
msgstr "Intervall (s)"

msgid "Set to 0 for on-demand (click the monitor name to refresh manually)."
msgstr "Auf 0 setzen für On-Demand (Monitornamen anklicken zum manuellen Aktualisieren)."

msgid "Interval Expr"
msgstr "Intervall-Ausdruck"

msgid "Optional JS expression. Must print() an interval in seconds. Access arguments as const NAME. Return 0 to skip this poll (re-checked every 60 s)."
msgstr "Optionaler JS-Ausdruck. Muss print() mit einem Intervall in Sekunden aufrufen. Auf Argumente als const NAME zugreifen. 0 zurückgeben, um diese Abfrage zu überspringen (alle 60 s erneut geprüft)."

msgid "Optional: capture group 1 used as value"
msgstr "Optional: Erfassungsgruppe 1 wird als Wert verwendet"

msgid "Output Regex"
msgstr "Ausgabe-Regex"

msgid "e.g. >70  or  60-80  (comma-separated)"
msgstr "z. B. >70  oder  60-80  (kommagetrennt)"

msgid "Caution Patterns"
msgstr "Vorsichtsmuster"

msgid "e.g. >90  or  critical (comma-separated)"
msgstr "z. B. >90  oder  kritisch  (kommagetrennt)"

msgid "Danger Patterns"
msgstr "Gefahrenmuster"

msgid "Show Sparkline"
msgstr "Sparkline anzeigen"

msgid "Export Monitors"
msgstr "Monitore exportieren"

msgid "Import Monitors"
msgstr "Monitore importieren"

msgid "Append"
msgstr "Anhängen"

msgid "Replace All"
msgstr "Alle ersetzen"

msgid "Monitors"
msgstr "Monitore"

msgid "My Monitors"
msgstr "Meine Monitore"

msgid "Monitors are executed on their configured interval."
msgstr "Monitore werden in ihrem konfigurierten Intervall ausgeführt."

msgid "Click a preset to add it to your monitor list."
msgstr "Eine Voreinstellung anklicken, um sie zur Monitorliste hinzuzufügen."

msgid "Add Preset"
msgstr "Voreinstellung hinzufügen"

msgid "Schedule Settings"
msgstr "Zeitplaneinstellungen"

msgid "Applied globally to all scheduled monitors."
msgstr "Global auf alle geplanten Monitore angewendet."

msgid "Schedule Jitter (%)"
msgstr "Zeitplan-Jitter (%)"

msgid "Random ±% offset on each poll interval — set to 0 for exact timing"
msgstr "Zufälliger ±%-Versatz bei jedem Abfrageintervall — auf 0 für genaues Timing setzen"

msgid "On-demand time display"
msgstr "On-Demand-Zeitanzeige"

msgid "Show collection time beneath on-demand monitor values"
msgstr "Erfassungszeit unter On-Demand-Monitorwerten anzeigen"

msgid "None"
msgstr "Keine"

msgid "Age (relative)"
msgstr "Alter (relativ)"

msgid "Timestamp (HH:MM:SS)"
msgstr "Zeitstempel (HH:MM:SS)"

msgid "Debug Logging"
msgstr "Debug-Protokollierung"

msgid "Debug Log"
msgstr "Debug-Protokoll"

msgid "View the debug log file"
msgstr "Debug-Protokolldatei anzeigen"

msgid "View Log"
msgstr "Protokoll anzeigen"

msgid "Clear Log"
msgstr "Protokoll leeren"

msgid "Setup Instructions"
msgstr "Einrichtungsanleitung"

msgid "Close"
msgstr "Schließen"

msgid "No monitors yet"
msgstr "Noch keine Monitore"

msgid "Use \"Add Monitor\" or a preset below."
msgstr "„Monitor hinzufügen“ oder eine Voreinstellung unten verwenden."

msgid "Move up"
msgstr "Nach oben"

msgid "Move down"
msgstr "Nach unten"

msgid "Edit"
msgstr "Bearbeiten"

msgid "Duplicate"
msgstr "Duplizieren"

msgid "Delete"
msgstr "Löschen"

msgid "Add to my monitors"
msgstr "Zu meinen Monitoren hinzufügen"

msgid "All presets added"
msgstr "Alle Voreinstellungen hinzugefügt"

msgid "Every available preset is already in your monitors."
msgstr "Alle verfügbaren Voreinstellungen sind bereits in Ihren Monitoren."
