msgid "No monitors configured"
msgstr "Brak skonfigurowanych monitorów"

msgid "Settings"
msgstr "Ustawienia"

msgid "Shell"
msgstr "Shell"

msgid "JavaScript"
msgstr "JavaScript"

msgid "Add Monitor"
msgstr "Dodaj monitor"

msgid "Edit Monitor"
msgstr "Edytuj monitor"

msgid "Cancel"
msgstr "Anuluj"

msgid "Save"
msgstr "Zapisz"

msgid "Name"
msgstr "Nazwa"

msgid "e.g. CPU Usage"
msgstr "np. Użycie CPU"

msgid "Optional: what this monitor measures"
msgstr "Opcjonalnie: co mierzy ten monitor"

msgid "Setup instructions…"
msgstr "Instrukcje konfiguracji…"

msgid "Command / Script"
msgstr "Polecenie / Skrypt"

msgid "Type"
msgstr "Typ"

msgid "Arguments"
msgstr "Argumenty"

msgid "+ Add"
msgstr "+ Dodaj"

msgid "JS: injected as const NAME = value  ·  Shell: injected as export NAME=value"
msgstr "JS: wstrzyknięte jako const NAME = value  ·  Shell: wstrzyknięte jako export NAME=value"

msgid "value"
msgstr "wartość"

msgid "Add Argument"
msgstr "Dodaj argument"

msgid "Add"
msgstr "Dodaj"

msgid "Identifier, e.g. EXCLUDE (no spaces)"
msgstr "Identyfikator, np. EXCLUDE (bez spacji)"

msgid "Display label, e.g. Exclude processes"
msgstr "Etykieta wyświetlania, np. Wyklucz procesy"

msgid "Label"
msgstr "Etykieta"

msgid "Actions"
msgstr "Akcje"

msgid "Commands run on demand from the monitor icon in the menu."
msgstr "Polecenia uruchamiane na żądanie z ikony monitora w menu."

msgid "Action label"
msgstr "Etykieta akcji"

msgid "Command or script"
msgstr "Polecenie lub skrypt"

msgid "JS condition on value (e.g. value === 'disabled')"
msgstr "Warunek JS na wartości (np. value === 'disabled')"

msgid "Interval (s)"
msgstr "Interwał (s)"

msgid "Set to 0 for on-demand (click the monitor name to refresh manually)."
msgstr "Ustaw na 0 dla trybu na żądanie (kliknij nazwę monitora, aby odświeżyć ręcznie)."

msgid "Interval Expr"
msgstr "Wyrażenie interwału"

msgid "Optional JS expression. Must print() an interval in seconds. Access arguments as const NAME. Return 0 to skip this poll (re-checked every 60 s)."
msgstr "Opcjonalne wyrażenie JS. Musi wywołać print() z interwałem w sekundach. Dostęp do argumentów jako const NAME. Zwróć 0, aby pominąć to odpytywanie (sprawdzane ponownie co 60 s)."

msgid "Optional: capture group 1 used as value"
msgstr "Opcjonalnie: grupa przechwytywania 1 używana jako wartość"

msgid "Output Regex"
msgstr "Regex wyjścia"

msgid "e.g. >70  or  60-80  (comma-separated)"
msgstr "np. >70  lub  60-80  (oddzielone przecinkami)"

msgid "Caution Patterns"
msgstr "Wzorce ostrzeżenia"

msgid "e.g. >90  or  critical (comma-separated)"
msgstr "np. >90  lub  krytyczny  (oddzielone przecinkami)"

msgid "Danger Patterns"
msgstr "Wzorce niebezpieczeństwa"

msgid "Show Sparkline"
msgstr "Pokaż wykres sparkline"

msgid "Export Monitors"
msgstr "Eksportuj monitory"

msgid "Import Monitors"
msgstr "Importuj monitory"

msgid "Append"
msgstr "Dołącz"

msgid "Replace All"
msgstr "Zastąp wszystkie"

msgid "Monitors"
msgstr "Monitory"

msgid "My Monitors"
msgstr "Moje monitory"

msgid "Monitors are executed on their configured interval."
msgstr "Monitory są wykonywane w skonfigurowanym interwale."

msgid "Click a preset to add it to your monitor list."
msgstr "Kliknij ustawienie wstępne, aby dodać je do listy monitorów."

msgid "Add Preset"
msgstr "Dodaj ustawienie wstępne"

msgid "Schedule Settings"
msgstr "Ustawienia harmonogramu"

msgid "Applied globally to all scheduled monitors."
msgstr "Stosowane globalnie do wszystkich zaplanowanych monitorów."

msgid "Schedule Jitter (%)"
msgstr "Zakłócenia harmonogramu (%)"

msgid "Random ±% offset on each poll interval — set to 0 for exact timing"
msgstr "Losowe przesunięcie ±% w każdym interwale odpytywania — ustaw na 0 dla dokładnego pomiaru czasu"

msgid "On-demand time display"
msgstr "Wyświetlanie czasu na żądanie"

msgid "Show collection time beneath on-demand monitor values"
msgstr "Pokaż czas zbierania danych pod wartościami monitora na żądanie"

msgid "None"
msgstr "Brak"

msgid "Age (relative)"
msgstr "Wiek (względny)"

msgid "Timestamp (HH:MM:SS)"
msgstr "Znacznik czasu (HH:MM:SS)"

msgid "Debug Logging"
msgstr "Rejestrowanie debugowania"

msgid "Debug Log"
msgstr "Dziennik debugowania"

msgid "View the debug log file"
msgstr "Wyświetl plik dziennika debugowania"

msgid "View Log"
msgstr "Wyświetl dziennik"

msgid "Clear Log"
msgstr "Wyczyść dziennik"

msgid "Setup Instructions"
msgstr "Instrukcje konfiguracji"

msgid "Close"
msgstr "Zamknij"

msgid "No monitors yet"
msgstr "Brak monitorów"

msgid "Use \"Add Monitor\" or a preset below."
msgstr "Użyj „Dodaj monitor" lub ustawienia wstępnego poniżej."

msgid "Move up"
msgstr "Przesuń w górę"

msgid "Move down"
msgstr "Przesuń w dół"

msgid "Edit"
msgstr "Edytuj"

msgid "Duplicate"
msgstr "Duplikuj"

msgid "Delete"
msgstr "Usuń"

msgid "Add to my monitors"
msgstr "Dodaj do moich monitorów"

msgid "All presets added"
msgstr "Wszystkie ustawienia wstępne dodane"

msgid "Every available preset is already in your monitors."
msgstr "Wszystkie dostępne ustawienia wstępne są już w twoich monitorach."
