msgid "No monitors configured"
msgstr "Ingen monitorer konfigureret"

msgid "Settings"
msgstr "Indstillinger"

msgid "Shell"
msgstr "Shell"

msgid "JavaScript"
msgstr "JavaScript"

msgid "Add Monitor"
msgstr "Tilføj monitor"

msgid "Edit Monitor"
msgstr "Rediger monitor"

msgid "Cancel"
msgstr "Annuller"

msgid "Save"
msgstr "Gem"

msgid "Name"
msgstr "Navn"

msgid "e.g. CPU Usage"
msgstr "f.eks. CPU-brug"

msgid "Optional: what this monitor measures"
msgstr "Valgfrit: hvad denne monitor måler"

msgid "Setup instructions…"
msgstr "Installationsvejledning…"

msgid "Command / Script"
msgstr "Kommando / Script"

msgid "Type"
msgstr "Type"

msgid "Arguments"
msgstr "Argumenter"

msgid "+ Add"
msgstr "+ Tilføj"

msgid "JS: injected as const NAME = value  ·  Shell: injected as export NAME=value"
msgstr "JS: injiceres som const NAME = value  ·  Shell: injiceres som export NAME=value"

msgid "value"
msgstr "værdi"

msgid "Add Argument"
msgstr "Tilføj argument"

msgid "Add"
msgstr "Tilføj"

msgid "Identifier, e.g. EXCLUDE (no spaces)"
msgstr "Identifikator, f.eks. EXCLUDE (ingen mellemrum)"

msgid "Display label, e.g. Exclude processes"
msgstr "Visetiket, f.eks. Ekskluder processer"

msgid "Label"
msgstr "Etiket"

msgid "Actions"
msgstr "Handlinger"

msgid "Commands run on demand from the monitor icon in the menu."
msgstr "Kommandoer kørt efter behov fra monitorikonen i menuen."

msgid "Action label"
msgstr "Handelsetiket"

msgid "Command or script"
msgstr "Kommando eller script"

msgid "JS condition on value (e.g. value === 'disabled')"
msgstr "JS-betingelse på værdien (f.eks. value === 'disabled')"

msgid "Interval (s)"
msgstr "Interval (s)"

msgid "Set to 0 for on-demand (click the monitor name to refresh manually)."
msgstr "Indstil til 0 for efter behov (klik på monitornavnet for at opdatere manuelt)."

msgid "Interval Expr"
msgstr "Intervaludtryk"

msgid "Optional JS expression. Must print() an interval in seconds. Access arguments as const NAME. Return 0 to skip this poll (re-checked every 60 s)."
msgstr "Valgfrit JS-udtryk. Skal kalde print() med et interval i sekunder. Adgang til argumenter som const NAME. Returner 0 for at springe denne polling over (kontrolleres igen hvert 60. s)."

msgid "Optional: capture group 1 used as value"
msgstr "Valgfrit: optagelsesgruppe 1 bruges som værdi"

msgid "Output Regex"
msgstr "Output-regex"

msgid "e.g. >70  or  60-80  (comma-separated)"
msgstr "f.eks. >70  eller  60-80  (kommasepareret)"

msgid "Caution Patterns"
msgstr "Forsigtighedsmønstre"

msgid "e.g. >90  or  critical (comma-separated)"
msgstr "f.eks. >90  eller  kritisk  (kommasepareret)"

msgid "Danger Patterns"
msgstr "Farlige mønstre"

msgid "Show Sparkline"
msgstr "Vis sparkline"

msgid "Export Monitors"
msgstr "Eksporter monitorer"

msgid "Import Monitors"
msgstr "Importer monitorer"

msgid "Append"
msgstr "Tilføj"

msgid "Replace All"
msgstr "Erstat alle"

msgid "Monitors"
msgstr "Monitorer"

msgid "My Monitors"
msgstr "Mine monitorer"

msgid "Monitors are executed on their configured interval."
msgstr "Monitorer udføres på deres konfigurerede interval."

msgid "Click a preset to add it to your monitor list."
msgstr "Klik på en forudindstilling for at tilføje den til din monitorliste."

msgid "Add Preset"
msgstr "Tilføj forudindstilling"

msgid "Schedule Settings"
msgstr "Planlægningsindstillinger"

msgid "Applied globally to all scheduled monitors."
msgstr "Anvendt globalt på alle planlagte monitorer."

msgid "Schedule Jitter (%)"
msgstr "Planlægningsjitter (%)"

msgid "Random ±% offset on each poll interval — set to 0 for exact timing"
msgstr "Tilfældig ±%-forskydning på hvert pollinginterval — indstil til 0 for præcis timing"

msgid "On-demand time display"
msgstr "Tidsvisning efter behov"

msgid "Show collection time beneath on-demand monitor values"
msgstr "Vis indsamlingstid under monitorværdier efter behov"

msgid "None"
msgstr "Ingen"

msgid "Age (relative)"
msgstr "Alder (relativ)"

msgid "Timestamp (HH:MM:SS)"
msgstr "Tidsstempel (HH:MM:SS)"

msgid "Debug Logging"
msgstr "Fejlretningslogning"

msgid "Debug Log"
msgstr "Fejlretningslog"

msgid "View the debug log file"
msgstr "Vis fejlretningslogfilen"

msgid "View Log"
msgstr "Vis log"

msgid "Clear Log"
msgstr "Ryd log"

msgid "Setup Instructions"
msgstr "Installationsvejledning"

msgid "Close"
msgstr "Luk"

msgid "No monitors yet"
msgstr "Ingen monitorer endnu"

msgid "Use \"Add Monitor\" or a preset below."
msgstr "Brug «Tilføj monitor» eller en forudindstilling nedenfor."

msgid "Move up"
msgstr "Flyt op"

msgid "Move down"
msgstr "Flyt ned"

msgid "Edit"
msgstr "Rediger"

msgid "Duplicate"
msgstr "Dupliker"

msgid "Delete"
msgstr "Slet"

msgid "Add to my monitors"
msgstr "Føj til mine monitorer"

msgid "All presets added"
msgstr "Alle forudindstillinger tilføjet"

msgid "Every available preset is already in your monitors."
msgstr "Alle tilgængelige forudindstillinger er allerede i dine monitorer."
