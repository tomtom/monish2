{
    "env": {
        "es2022": true,
        "node":   true
    },
    "parserOptions": {
        "ecmaVersion":  2022,
        "sourceType":   "module"
    },
    "rules": {
        "no-unused-vars":       ["warn", {"argsIgnorePattern": "^_"}],
        "no-console":           "off",
        "semi":                 ["error", "always"],
        "indent":               ["error", 4],
        "quotes":               ["error", "single"],
        "eol-last":             ["error", "always"],
        "no-trailing-spaces":   "error",
        "comma-dangle":         ["error", "always-multiline"],
        "keyword-spacing":      ["error", {"before": true, "after": true}],
        "space-before-blocks":  "error"
    }
}
